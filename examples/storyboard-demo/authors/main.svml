<?svml using="@hypit/markup@1"?>
<svml>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="media" from="@hypit/media@1"/>
  <import as="mythic" from="hypit-mythic-canvas-track@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="style" source="./main.svs"/>

  <time:Clock id="clock" frame-rate="30"/>
  <time:Timeline id="program" clock={clock} end="6s"/>
  <space:Canvas id="canvas" width="1080" height="1920"/>
  <media:Image id="scene01" src="../assets/back.jpg"/>
  <media:Image id="scene02" src="../assets/scene-02.png"/>
  <media:Image id="title-overlay" src="../assets/title.png"/>

  <mythic:Track id="visual" timeline={program.timeline} canvas={canvas}
    title={title-overlay} title-fade-start="1.8" title-end="2.5"
    badge-size="34" subtitle-size="56" badge-y="1450" subtitle-y="1574" during="program">
    <mythic:Scene id="scene-01" image={scene01} at="0"
      start-zoom="1.00" end-zoom="1.06" start-y="0" end-y="-8"/>
    <mythic:Scene id="scene-02" image={scene02} at="3"
      start-zoom="1.08" end-zoom="1.00" start-y="8" end-y="-5"/>
    <mythic:Cue id="cue-01" start="0.4" end="2.8"
      role="【 NARRATOR 】" text="A luminous beginning" tone="gold">
      <mythic:Word text="A " start="0.4" end="0.8"/>
      <mythic:Word text="luminous " start="0.8" end="1.7"/>
      <mythic:Word text="beginning" start="1.7" end="2.8"/>
    </mythic:Cue>
    <mythic:Cue id="cue-02" start="3.2" end="5.7"
      role="【 SEEKER 】" text="让光引你前行" tone="blue">
      <mythic:Word text="让" start="3.2" end="3.6"/>
      <mythic:Word text="光" start="3.6" end="3.9"/>
      <mythic:Word text="引" start="3.9" end="4.3"/>
      <mythic:Word text="你" start="4.3" end="4.7"/>
      <mythic:Word text="前" start="4.7" end="5.2"/>
      <mythic:Word text="行" start="5.2" end="5.7"/>
    </mythic:Cue>
    <mythic:Effect id="gold-dust" amount="0.65" min-size="3" max-size="7"
      color="#FFE6A8" seed="12"/>
    <mythic:Effect id="soft-bokeh" amount="0.14" min-size="64" max-size="140"
      color="#FFD98A" seed="22"/>
  </mythic:Track>

  <film:Film id="main" canvas={canvas} timeline={program.timeline} appearance={style.film.main}>
    <film:Track source={visual.track}/>
  </film:Film>
  <render:Video id="preview" composition={main.composition} timeline={program.timeline}/>
</svml>
